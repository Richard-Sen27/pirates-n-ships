      }
    },
    {
      "apply": {
        "model": "pirates_n_ships:block/railing_latch",
        "y": 90
      },
      "when": {
        "latch": "east"
      }
    },
    {
      "apply": {
        "model": "pirates_n_ships:block/railing_latch",
        "y": 180
      },
      "when": {
        "latch": "south"
