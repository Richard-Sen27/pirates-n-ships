{
  "multipart": [
    {
      "apply": {
        "model": "pirates_n_ships:block/oak_railing_edge"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "pirates_n_ships:block/oak_railing_edge",
        "uvlock": true,
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "pirates_n_ships:block/oak_railing_edge",
        "uvlock": true,
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "pirates_n_ships:block/oak_railing_edge",
        "uvlock": true,
        "y": 270
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "pirates_n_ships:block/oak_railing_post"
      },
      "when": {
        "post_nw": "true"
      }
    },
    {
      "apply": {
        "model": "pirates_n_ships:block/oak_railing_post",
        "uvlock": true,
        "y": 90
      },
      "when": {
        "post_ne": "true"
      }
    },
    {
      "apply": {
        "model": "pirates_n_ships:block/oak_railing_post",
        "uvlock": true,
        "y": 180
      },
      "when": {
